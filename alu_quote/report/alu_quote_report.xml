<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="alu_quote_report_action" model="ir.actions.report">
        <field name="name">Quote</field>
        <field name="model">alu.quote</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alu_quote.report_alu_quote</field>
        <field name="report_file">alu_quote.report_alu_quote</field>
        <field name="print_report_name">'Quote - %s' % object.name</field>
        <field name="binding_model_id" ref="model_alu_quote"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_alu_quote">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Quote <span t-field="o.name"/></h2>
                        <p>
                            <strong>Customer:</strong> <span t-field="o.partner_id"/><br/>
                            <strong>Date:</strong> <span t-field="o.date"/>
                        </p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Profile</th>
                                    <th class="text-end">Length (m)</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Weight (kg)</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.profile_name"/></td>
                                    <td class="text-end"><span t-field="line.length_m"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.weight"/></td>
                                    <td class="text-end"><span t-field="line.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-end">
                            <strong>Total weight:</strong> <span t-field="o.total_weight"/> kg<br/>
                            <strong>Total:</strong> <span t-field="o.total_amount"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
